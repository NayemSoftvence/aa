rules_version = '2';
service cloud.firestore {
match /databases/{database}/documents {
function isSignedIn() {
  return request.auth != null;
}

// USERS
match /users/{uid} {
  allow read: if isSignedIn();
  // Ensure the uid in the doc matches the path/auth user
  allow create: if isSignedIn()
                && request.auth.uid == uid
                && request.resource.data.uid == uid;
  allow update: if isSignedIn()
                && request.auth.uid == uid
                && request.resource.data.uid == uid;
  allow delete: if false;
}

// CALLS
function isParticipant() {
  return isSignedIn() &&
    (resource.data.callerId == request.auth.uid ||
     resource.data.calleeId == request.auth.uid ||
     (resource.data.participants != null && request.auth.uid in resource.data.participants));
}

// Validate minimal create shape
function validCallCreate() {
  return request.resource.data.callerId == request.auth.uid
    && request.resource.data.calleeId is string
    && request.resource.data.calleeId != request.auth.uid
    && request.resource.data.roomName is string
    && request.resource.data.status in ['ringing', 'accepted', 'declined', 'ended']
    // optional participants array used by your app:
    && request.resource.data.participants.size() == 2
    && request.resource.data.participants.hasAll(
         [request.resource.data.callerId, request.resource.data.calleeId]
       );
}

// Only allow status/timestamps to change after create
function allowedCallUpdateFieldsOnly() {
  return request.resource.data.diff(resource.data)
           .changedKeys()
           .hasOnly(['status','acceptedAt','endedAt']);
}

// Prevent changing caller/callee/room/participants on update
function sameImmutableCallFields() {
  return request.resource.data.callerId == resource.data.callerId
      && request.resource.data.calleeId == resource.data.calleeId
      && request.resource.data.roomName == resource.data.roomName
      && request.resource.data.participants == resource.data.participants;
}


match /calls/{callId} {
  allow create: if isSignedIn() && validCallCreate();

  // FIX: Added 'list' permission explicitly and checked participants array
  allow read, list: if isSignedIn() &&
    (resource.data.callerId == request.auth.uid ||
     resource.data.calleeId == request.auth.uid ||
     (resource.data.participants != null && request.auth.uid in resource.data.participants));

  allow update: if isParticipant()
                && sameImmutableCallFields()
                && allowedCallUpdateFieldsOnly();

  allow delete: if false;
}

// Deny everything else
match /{document=**} {
  allow read, write: if false;
}

}
}
